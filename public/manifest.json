{
    "manifest_version": 3,
    "name": "Swipe",
    "version": "1.0.0",
    "description": "A simple extension to maximize your credit card rewards.",
    "action": {
        "default_popup": "index.html"
        
    },
    "permissions": [
        "scripting"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ]
  }